<Window x:Class="IptvPlayer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
 Title="CatLu IPTV" Icon="Assets/catlu.ico" Width="1280" Height="800" MinWidth="960" MinHeight="620"
 Background="#111418" Foreground="#ECEEF2" FontFamily="Segoe UI" FontSize="14" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#D9D755"/>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="8"/><Setter Property="Background" Value="#20252C"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}">
     <Track x:Name="PART_Track" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#515965" CornerRadius="4" Margin="1,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E7E9EE"/><Setter Property="Background" Value="#252A32"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#15191F" BorderBrush="#444B55" BorderThickness="1" CornerRadius="3"/></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="9,8,27,8" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <TextBlock Text="▾" Foreground="#A3AAB5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
      <Border Background="#252A32" BorderBrush="#444B55" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
       <ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#ECEEF2"/><Setter Property="Padding" Value="9,7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="GroupRow" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="GroupRow" Property="Background" Value="#44462C"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#ECEEF2"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="14,11"/><Setter Property="Background" Value="#292E36"/>
   <Setter Property="BorderBrush" Value="#1C2027"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#373D46"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#44462C"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <DockPanel Margin="18">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image Source="Assets/catlu.png" Width="32" Height="32" Margin="0,0,10,0" AutomationProperties.Name="Кот CatLu"/>
    <TextBlock Text="CatLu IPTV" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,22,0"/>
    <Button Content="☰  Каналы" Click="ToggleChannels_Click"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="OpenPlaylist" Content="Открыть M3U" Click="OpenPlaylist_Click" Margin="0,0,8,0"/>
    <Button x:Name="OpenEpg" Content="Открыть EPG" Click="OpenEpg_Click" Margin="0,0,8,0"/>
    <Button x:Name="RefreshEpg" Content="↻  Обновить EPG" Click="RefreshEpg_Click" Background="#383B27" Foreground="{StaticResource Accent}"/>
   </StackPanel>
  </Grid>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="Загрузка…" Foreground="#A3AAB5" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="ChannelsColumn" Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#20252C" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="12">
      <TextBlock Text="КАНАЛЫ" Foreground="#A3AAB5" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <ComboBox x:Name="Groups" SelectionChanged="Filters_Changed" Margin="0,0,0,9" Background="#252A32" Foreground="#ECEEF2" Padding="8" AutomationProperties.Name="Группа каналов"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <CheckBox x:Name="FavoritesOnly" Content="★ Только избранные" Foreground="{StaticResource Accent}" Checked="Filters_Changed" Unchecked="Filters_Changed" Margin="0,0,0,10"/>
      <TextBox x:Name="Search" TextChanged="Search_Changed" Background="#15191F" Foreground="#ECEEF2" CaretBrush="{StaticResource Accent}" BorderBrush="#444B55" Padding="8" AutomationProperties.Name="Поиск по названию или группе" ToolTip="Поиск по названию или группе"/>
      <TextBlock x:Name="ChannelCount" FontSize="11" Foreground="#A3AAB5" Margin="0,8,0,0"/>
     </StackPanel>
     <TextBlock x:Name="ChannelsEmpty" DockPanel.Dock="Top" Text="Каналы не найдены. Измените группу или фильтры." Foreground="#A3AAB5" Margin="12,6" TextWrapping="Wrap" Visibility="Collapsed"/>
     <ListBox x:Name="Channels" SelectionChanged="Channel_Changed" MouseDoubleClick="Channel_DoubleClick" AutomationProperties.Name="Каналы">
      <ListBox.ItemTemplate><DataTemplate>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
         <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
         <TextBlock Text="{Binding GroupDisplay}" FontSize="11" Foreground="#A3AAB5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding FavoriteGlyph}" Click="Favorite_Click" Foreground="{StaticResource Accent}" Background="Transparent" FontSize="20" Padding="4,2" VerticalAlignment="Center" ToolTip="Добавить или убрать из избранного" AutomationProperties.Name="{Binding Name, StringFormat='Избранное: {0}'}"/>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="1" Background="#292E36" CornerRadius="6" ClipToBounds="True">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <vlc:VideoView x:Name="Video" Background="#101317"/>
     <StackPanel Grid.Row="1" Margin="18,14,18,16">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="CurrentChannel" Text="Выберите канал" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="PlaybackState" Grid.Column="1" Text="Остановлено" Foreground="#A3AAB5" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </Grid>
      <TextBlock x:Name="NowTitle" Text="Откройте список каналов" Foreground="{StaticResource Accent}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="NextTitle" Foreground="#ADB4BF" FontSize="12" Margin="0,4,0,12" TextTrimming="CharacterEllipsis"/>
      <Grid Margin="0,0,0,14">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="ProgrammeStart" Text="—" Foreground="{StaticResource Accent}" FontSize="12"/>
       <ProgressBar x:Name="ProgrammeProgress" Grid.Column="1" Height="3" Margin="12,0" VerticalAlignment="Center" Minimum="0" Maximum="100" Background="#505660" Foreground="{StaticResource Accent}" BorderThickness="0" AutomationProperties.Name="Ход текущей передачи"/>
       <TextBlock x:Name="ProgrammeEnd" Grid.Column="2" Text="—" Foreground="#ADB4BF" FontSize="12"/>
      </Grid>
      <WrapPanel>
       <Button Content="▶" Click="Play_Click" Background="{StaticResource Accent}" Foreground="#14171B" Padding="16,9" FontSize="17" ToolTip="Воспроизвести" AutomationProperties.Name="Воспроизвести"/>
       <Button Content="Ⅱ" Click="Pause_Click" Margin="8,0,0,0" FontSize="17" ToolTip="Пауза / продолжить" AutomationProperties.Name="Пауза или продолжить"/>
       <Button Content="■" Click="Stop_Click" Margin="8,0,0,0" FontSize="17" ToolTip="Остановить" AutomationProperties.Name="Остановить"/>
       <TextBlock Text="♪" Foreground="#ADB4BF" VerticalAlignment="Center" Margin="18,0,8,0" ToolTip="Громкость"/>
       <Slider x:Name="Volume" Width="80" Minimum="0" Maximum="100" Value="70" ValueChanged="Volume_Changed" VerticalAlignment="Center" AutomationProperties.Name="Громкость"/>
       <Button Content="⛶" Click="Fullscreen_Click" Margin="12,0,0,0" FontSize="19" Padding="10,7" ToolTip="Полный экран (F11), выход — Esc" AutomationProperties.Name="Полный экран"/>
      </WrapPanel>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="3" Background="#20252C" CornerRadius="6" ClipToBounds="True">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="16,15">
      <TextBlock Text="ПРОГРАММА ПЕРЕДАЧ" FontSize="11" FontWeight="SemiBold" Foreground="#A3AAB5"/>
      <TextBlock x:Name="GuideTitle" Text="Выберите канал" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="Время вашего компьютера" FontSize="11" Foreground="#8D96A3" Margin="0,5,0,0"/>
     </StackPanel>
     <TextBlock x:Name="GuideEmpty" DockPanel.Dock="Top" Margin="16,8" Foreground="#A3AAB5" TextWrapping="Wrap"/>
     <ListBox x:Name="Guide" AutomationProperties.Name="Программа передач">
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel>
        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding TimeRange}" FontSize="12" Foreground="#B5BBC5"/>
         <TextBlock Grid.Column="1" Text="{Binding Duration}" FontSize="12" Foreground="#B5BBC5" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock x:Name="CurrentBadge" Text="Сейчас в эфире" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,5,0,0" Visibility="Collapsed"/>
       </StackPanel>
       <DataTemplate.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="CurrentBadge" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</Window>
